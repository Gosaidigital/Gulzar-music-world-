{
  "entities": {
    "Song": {
      "title": "Song",
      "description": "Music recording track in Chhattisgarhi catalog",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "singer": { "type": "string", "minLength": 1, "maxLength": 200 },
        "artist": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "type": "string", "minLength": 1, "maxLength": 100 },
        "albumId": { "type": "string", "maxLength": 100 },
        "albumName": { "type": "string", "maxLength": 200 },
        "coverUrl": { "type": "string", "maxLength": 1000 },
        "audioUrl": { "type": "string", "maxLength": 1000 },
        "youtubeUrl": { "type": "string", "maxLength": 500 },
        "lyrics": { "type": "string", "maxLength": 10000 },
        "releaseDate": { "type": "string", "maxLength": 50 },
        "duration": { "type": "string", "maxLength": 20 },
        "playsCount": { "type": "number" },
        "description": { "type": "string", "maxLength": 2000 },
        "seoTitle": { "type": "string", "maxLength": 200 },
        "seoDescription": { "type": "string", "maxLength": 500 },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["title", "singer", "category"]
    },
    "Album": {
      "title": "Album",
      "description": "Chhattisgarhi Music Album compilation",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "coverUrl": { "type": "string", "maxLength": 1000 },
        "artist": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "type": "string", "minLength": 1, "maxLength": 100 },
        "releaseDate": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 2000 },
        "trackCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["title", "artist", "category"]
    },
    "Artist": {
      "title": "Artist",
      "description": "Singer or music director profile",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "role": { "type": "string", "maxLength": 100 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "bio": { "type": "string", "maxLength": 3000 },
        "category": { "type": "string", "maxLength": 100 },
        "followersCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["name"]
    },
    "Video": {
      "title": "Video",
      "description": "Music video YouTube embed",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "youtubeUrl": { "type": "string", "maxLength": 500 },
        "youtubeId": { "type": "string", "maxLength": 100 },
        "thumbnailUrl": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 100 },
        "artist": { "type": "string", "maxLength": 200 },
        "viewsCount": { "type": "number" },
        "releaseDate": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["title", "youtubeUrl"]
    },
    "Gallery": {
      "title": "Gallery",
      "description": "Studio photo gallery item",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 100 },
        "caption": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["imageUrl"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Studio recording booking inquiry",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 200 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "userPhone": { "type": "string", "maxLength": 50 },
        "serviceType": { "type": "string", "maxLength": 100 },
        "preferredDate": { "type": "string", "maxLength": 50 },
        "preferredTime": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Completed", "Cancelled"] },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["userName", "userPhone", "serviceType", "preferredDate"]
    },
    "Contact": {
      "title": "Contact",
      "description": "Contact inquiry submission",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 3000 },
        "status": { "type": "string", "enum": ["New", "In Progress", "Resolved"] },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["name", "email", "message"]
    },
    "User": {
      "title": "User",
      "description": "User profile and permissions",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["email"]
    },
    "Blog": {
      "title": "Blog",
      "description": "Chhattisgarhi music news or blog post",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 250 },
        "slug": { "type": "string", "maxLength": 250 },
        "coverUrl": { "type": "string", "maxLength": 1000 },
        "content": { "type": "string", "maxLength": 20000 },
        "author": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["title", "content"]
    }
  },
  "firestore": {
    "/songs/{songId}": { "schema": "Song", "description": "Songs collection" },
    "/albums/{albumId}": { "schema": "Album", "description": "Albums collection" },
    "/artists/{artistId}": { "schema": "Artist", "description": "Artists collection" },
    "/videos/{videoId}": { "schema": "Video", "description": "Videos collection" },
    "/gallery/{galleryId}": { "schema": "Gallery", "description": "Gallery photos" },
    "/bookings/{bookingId}": { "schema": "Booking", "description": "Studio bookings" },
    "/contacts/{contactId}": { "schema": "Contact", "description": "Contact messages" },
    "/users/{userId}": { "schema": "User", "description": "User profile documents" },
    "/blogs/{blogId}": { "schema": "Blog", "description": "Blog news documents" }
  }
}
